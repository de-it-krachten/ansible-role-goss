---

# Generic
generic:
  role: ansible-role-goss
  role_short: goss
  role_description: |
    Installs goss, quick and Easy server testing/validation<br>
    https://goss.rocks<br>
    https://github.com/goss-org/goss<br>
  collections: []

# Supported platforms
platforms:
  sles15:
    supported: true
    ci: false
  sles16:
    supported: true
    ci: false
  opensuse15:
    supported: true
    ci: true
  opensuse16:
    supported: true
    ci: true
  ubuntu2004:
    supported: true
    ci: true

molecule:
  requirements:
    roles_extra: []
